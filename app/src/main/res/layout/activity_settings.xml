<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
      背景层：玻璃卡片的采样源。
      必须独立成层，不能让玻璃采样整个 root —— root 里包含玻璃自己，
      会形成互相捕获（重绘时内存/栈爆掉，表现为点击后进程被杀重启）。
    -->
    <FrameLayout
        android:id="@+id/settings_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_settings">

        <!-- 顶部柔光装饰：给玻璃提供可折射的细节 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:background="@drawable/bg_settings_glow" />
    </FrameLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/tv_screen_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="8dp"
                android:shadowColor="#40000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text="@string/action_settings"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- ============ 数据源 ============ -->
            <com.example.liquidglass.LiquidGlassView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:bevelWidth="30dp"
                app:blurAmount="0.75"
                app:cornerRadius="26dp"
                app:dispersionStrength="0"
                app:aberrationIntensity="0"
                app:glassMaterial="regular"
                app:refractionHeight="28dp"
                app:saturation="150"
                app:sensorHighlight="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.85"
                        android:shadowColor="#33000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="2"
                        android:text="@string/settings_source_label"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/source_row"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_glass_inner"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:id="@+id/tv_source_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:shadowColor="#33000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="2"
                            android:textColor="@color/white"
                            android:textSize="15sp" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#B3FFFFFF" />
                    </LinearLayout>
                </LinearLayout>
            </com.example.liquidglass.LiquidGlassView>

            <!-- ============ API Key ============ -->
            <com.example.liquidglass.LiquidGlassView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:bevelWidth="30dp"
                app:blurAmount="0.75"
                app:cornerRadius="26dp"
                app:dispersionStrength="0"
                app:aberrationIntensity="0"
                app:glassMaterial="regular"
                app:refractionHeight="28dp"
                app:saturation="150"
                app:sensorHighlight="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/tv_key_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.85"
                        android:shadowColor="#33000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="2"
                        android:text="@string/settings_token_label"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/et_key"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_glass_inner"
                        android:hint="@string/settings_token_hint"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"
                        android:minHeight="48dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/white"
                        android:textColorHint="#80FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_get_key"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:text="@string/settings_get_token"
                        android:textColor="@color/link"
                        android:textSize="13sp" />

                    <!-- 和风天气 API Host（仅选和风时显示） -->
                    <LinearLayout
                        android:id="@+id/qw_host_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:alpha="0.85"
                            android:shadowColor="#33000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="2"
                            android:text="@string/settings_qw_host_label"
                            android:textColor="@color/white"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/et_qw_host"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_glass_inner"
                            android:hint="@string/settings_qw_host_hint"
                            android:importantForAutofill="no"
                            android:inputType="textUri"
                            android:maxLines="1"
                            android:minHeight="48dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:textColor="@color/white"
                            android:textColorHint="#80FFFFFF"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:alpha="0.6"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/settings_qw_host_note"
                            android:textColor="@color/white"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:alpha="0.6"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/settings_keys_note"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.example.liquidglass.LiquidGlassView>

            <!-- ============ 显示设置（单位 / 语言） ============ -->
            <com.example.liquidglass.LiquidGlassView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:bevelWidth="30dp"
                app:blurAmount="0.75"
                app:cornerRadius="26dp"
                app:dispersionStrength="0"
                app:aberrationIntensity="0"
                app:glassMaterial="regular"
                app:refractionHeight="28dp"
                app:saturation="150"
                app:sensorHighlight="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.85"
                        android:shadowColor="#33000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="2"
                        android:text="@string/settings_units_label"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/units_row"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_glass_inner"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:id="@+id/tv_units_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:shadowColor="#33000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="2"
                            android:textColor="@color/white"
                            android:textSize="15sp" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#B3FFFFFF" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:alpha="0.6"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/settings_units_note"
                        android:textColor="@color/white"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="14dp"
                        android:background="#1FFFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.85"
                        android:shadowColor="#33000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="2"
                        android:text="@string/settings_language_label"
                        android:textColor="@color/white"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:id="@+id/language_row"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_glass_inner"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:id="@+id/tv_language_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:shadowColor="#33000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="2"
                            android:textColor="@color/white"
                            android:textSize="15sp" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#B3FFFFFF" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:alpha="0.6"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/settings_language_note"
                        android:textColor="@color/white"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.example.liquidglass.LiquidGlassView>

            <!-- ============ 保存 ============ -->
            <com.example.liquidglass.LiquidGlassView
                android:id="@+id/glass_save"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                app:bevelWidth="30dp"
                app:blurAmount="0.75"
                app:cornerRadius="27dp"
                app:dispersionStrength="0"
                app:aberrationIntensity="0"
                app:glassMaterial="regular"
                app:refractionHeight="28dp"
                app:saturation="150"
                app:sensorHighlight="false">

                <TextView
                    android:id="@+id/btn_save"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:shadowColor="#40000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:text="@string/action_save"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </com.example.liquidglass.LiquidGlassView>

            <TextView
                android:id="@+id/tv_about"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:alpha="0.55"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/settings_about"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
