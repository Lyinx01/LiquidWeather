<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="28dp" />
            <gradient
                android:angle="315"
                android:startColor="#FF2F4157"
                android:centerColor="#FF4B6378"
                android:endColor="#FF8298AB" />
        </shape>
    </item>
    <item android:gravity="top|start">
        <shape>
            <gradient
                android:type="radial"
                android:centerX="0"
                android:centerY="0"
                android:gradientRadius="200dp"
                android:startColor="#3D9FB8CC"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item android:gravity="bottom">
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#00FFFFFF"
                android:endColor="#1F8FA8BF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="28dp" />
            <stroke
                android:width="1dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>
</layer-list>