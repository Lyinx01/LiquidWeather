<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="28dp" />
            <gradient
                android:angle="315"
                android:startColor="#FF414F5C"
                android:centerColor="#FF6A7A89"
                android:endColor="#FF9DACB8" />
        </shape>
    </item>
    <item android:gravity="top|start">
        <shape>
            <gradient
                android:type="radial"
                android:centerX="0"
                android:centerY="0"
                android:gradientRadius="200dp"
                android:startColor="#4794A6B4"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item android:gravity="bottom">
        <shape>
            <gradient
                android:angle="90"
                android:startColor="#00FFFFFF"
                android:endColor="#219EAFBC" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="28dp" />
            <stroke
                android:width="1dp"
                android:color="#47FFFFFF" />
        </shape>
    </item>
</layer-list>