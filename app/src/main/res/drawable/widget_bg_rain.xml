<?xml version="1.0" encoding="utf-8"?>
<!-- 小部件背景（雨）。每个 item 都要带 <corners> 且不要用 android:gravity，见 widget_bg_sunny.xml 的说明。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="28dp" />
            <gradient
                android:angle="315"
                android:startColor="#FF1B2A38"
                android:centerColor="#FF2C4459"
                android:endColor="#FF54728C" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="28dp" />
            <gradient
                android:type="radial"
                android:centerX="0"
                android:centerY="0"
                android:gradientRadius="200dp"
                android:startColor="#3D6FA8C7"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="28dp" />
            <gradient
                android:angle="90"
                android:startColor="#00FFFFFF"
                android:endColor="#1F5E93B0" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="28dp" />
            <stroke
                android:width="1dp"
                android:color="#47FFFFFF" />
        </shape>
    </item>
</layer-list>
