<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#0A1228"
                android:centerColor="#16283F"
                android:endColor="#2A4468" />
